<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CpuSpy.Dark" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">#121212</item>
        <item name="android:colorBackground">#121212</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="appBackgroundColor">#121212</item>
        <item name="headerBackgroundColor">#1E1E1E</item>
        <item name="headerTextColor">#FFFFFF</item>
        <item name="primaryTextColor">#FFFFFF</item>
        <item name="secondaryTextColor">#B0B0B0</item>
        <item name="percentageTextColor">#90CAF9</item>
        <item name="dividerColor">#2E2E2E</item>
        <item name="progressTint">#42A5F5</item>
        <item name="progressBackgroundTint">#333333</item>
        <item name="warningBackgroundColor">#4A1515</item>
        <item name="warningTextColor">#FFCDD2</item>
    </style>

    <style name="Theme.CpuSpy.Light" parent="@android:style/Theme.DeviceDefault.Light">
        <item name="android:windowBackground">#F8F9FA</item>
        <item name="android:colorBackground">#F8F9FA</item>
        <item name="android:statusBarColor">#F8F9FA</item>
        <item name="android:navigationBarColor">#F8F9FA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="appBackgroundColor">#F8F9FA</item>
        <item name="headerBackgroundColor">#E8EAED</item>
        <item name="headerTextColor">#202124</item>
        <item name="primaryTextColor">#202124</item>
        <item name="secondaryTextColor">#5F6368</item>
        <item name="percentageTextColor">#1976D2</item>
        <item name="dividerColor">#E0E0E0</item>
        <item name="progressTint">#1976D2</item>
        <item name="progressBackgroundTint">#E0E0E0</item>
        <item name="warningBackgroundColor">#FFEBEE</item>
        <item name="warningTextColor">#C62828</item>
    </style>

    <!-- Header style that adapts to current theme -->
    <style name="infoHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">6dp</item>
        <item name="android:background">?attr/headerBackgroundColor</item>
        <item name="android:textColor">?attr/headerTextColor</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

</resources>
