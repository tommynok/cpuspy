<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBackgroundColor">

    <!-- Page: Frequencies (default) -->
    <ScrollView
        android:id="@+id/ui_page_freq"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">

            <com.bvalosek.cpuspy.ui.CpuStatesChartView
                android:id="@+id/ui_states_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/ui_states_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_states_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/warningBackgroundColor"
                android:padding="6dp"
                android:text="@string/warning_no_states"
                android:textColor="?attr/warningTextColor"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_header_additional_states"
                style="@style/infoHeader"
                android:text="@string/header_unused_states"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_additional_states"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_header_total_state_time"
                style="@style/infoHeader"
                android:text="@string/header_total_state_time" />

            <TextView
                android:id="@+id/ui_total_state_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:padding="6dp"
                android:textColor="?attr/primaryTextColor"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/infoHeader"
                android:text="@string/header_kernel_info" />

            <TextView
                android:id="@+id/ui_kernel_string"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Page: Wakelocks -->
    <ScrollView
        android:id="@+id/ui_page_wakelocks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/ui_wakelocks_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wakelocks_loading"
                    android:textColor="?attr/secondaryTextColor"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ui_wakelocks_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/warningBackgroundColor"
                android:padding="8dp"
                android:textColor="?attr/warningTextColor"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ui_wakelocks_filter_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ui_filter_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/percentageTextColor"
                    android:text="@string/filter_apps_only" />

                <TextView
                    android:id="@+id/ui_filter_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryTextColor" />
            </LinearLayout>

            <com.bvalosek.cpuspy.ui.WakelocksView
                android:id="@+id/ui_wakelocks_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
