<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBackgroundColor">

    <!-- Tab switcher strip -->
    <LinearLayout
        android:id="@+id/ui_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:background="?attr/headerBackgroundColor">

        <TextView
            android:id="@+id/ui_tab_freq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:text="@string/tab_frequencies"
            android:textColor="?attr/headerTextColor" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/dividerColor" />

        <TextView
            android:id="@+id/ui_tab_wakelocks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:text="@string/tab_wakelocks"
            android:textColor="?attr/secondaryTextColor" />

    </LinearLayout>

    <!-- Active tab indicator line -->
    <View
        android:id="@+id/ui_tab_indicator"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/progressTint" />

    <!-- Page: Frequencies -->
    <ScrollView
        android:id="@+id/ui_page_freq"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">

            <com.bvalosek.cpuspy.ui.CpuStatesChartView
                android:id="@+id/ui_states_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/ui_states_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_states_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/warningBackgroundColor"
                android:padding="6dp"
                android:text="@string/warning_no_states"
                android:textColor="?attr/warningTextColor"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_header_additional_states"
                style="@style/infoHeader"
                android:text="@string/header_unused_states"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_additional_states"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_header_total_state_time"
                style="@style/infoHeader"
                android:text="@string/header_total_state_time" />

            <TextView
                android:id="@+id/ui_total_state_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:padding="6dp"
                android:textColor="?attr/primaryTextColor"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/infoHeader"
                android:text="@string/header_kernel_info" />

            <TextView
                android:id="@+id/ui_kernel_string"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Page: Wakelocks -->
    <ScrollView
        android:id="@+id/ui_page_wakelocks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/ui_wakelocks_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/warningBackgroundColor"
                android:padding="8dp"
                android:textColor="?attr/warningTextColor"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.bvalosek.cpuspy.ui.WakelocksView
                android:id="@+id/ui_wakelocks_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
